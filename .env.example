# ============================================
# Blinkit Support Agent - Environment Template
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env.

# ---- OpenRouter LLM ----
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=anthropic/claude-haiku-4.5

# ---- Backend ----
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ---- SQLite ----
SQLITE_DB_PATH=database/blinkit_support.db

# ---- ChromaDB ----
CHROMA_URL=http://localhost:8000
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=blinkit_faqs

# ---- Python FastAPI ----
PYTHON_SERVICE_URL=http://127.0.0.1:8001
PYTHON_SERVICE_TIMEOUT=8000

# ---- JWT (for auth middleware) ----
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# ---- Redis (optional caching) ----
REDIS_URL=redis://localhost:6379
USE_REDIS=false

# ---- Frontend ----
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
